# Project Configuration
DATA_DIR=data
OUTPUT_DIR=output
SEED=42

# Models
GRM_MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
SOLVER_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct # Default solver model
SOLVER_MODEL_NAMES=Qwen/Qwen2.5-7B-Instruct,Qwen/Qwen2.5-3B-Instruct,meta-llama/Llama-3.2-3B-Instruct,google/gemma-2-2b-it,microsoft/Phi-3.5-mini-instruct

# Solver Remote Configuration (Optional)
SOLVER_REMOTE=False
SOLVER_API_KEY=sk-your-solver-api-key
SOLVER_API_BASE=https://api.openai.com/v1

# Oracle / Judge (OpenAI Compatible API)
ORACLE_MODEL_NAME=gpt-4o
ORACLE_API_KEY=sk-your-api-key-here
ORACLE_API_BASE=https://api.openai.com/v1

# Data Configuration
DATASET_NAMES=HuggingFaceH4/no_robots,hieunguyenminh/roleplay,hakurei/open-instruct-v1,nvidia/OpenMathInstruct-1,nickrosh/Evol-Instruct-Code-80k-v1
DATASET_NAME=HuggingFaceH4/no_robots # Default dataset
NUM_SAMPLES=5000
OUTPUT_FILE=data/synthetic_rubrics.jsonl

# RL Configuration
RL_ALGORITHM=dapo
RL_TOTAL_STEPS=1000

# Parallel API Call Configuration
GRM_SOLVER_WORKERS=1   # Parallel workers for Solver API calls
GRM_ORACLE_WORKERS=1   # Parallel workers for Oracle/Judge API calls
GRM_REWARD_WORKERS=1   # Parallel workers for reward computation

# Huggingface Download Destination
HF_HOME=./data

# SFT Pipeline Configuration (run_sft.sh)
# Update paths to your local workspace root.
PYTHON_BIN=/path/to/GRM/.venv/bin/python
BASE_MODEL=Qwen/Qwen3-0.6B
POST_MODEL_PATH=

LIMIT_PER_DATASET=100
BENCH_NUM_SAMPLES=120
BENCHMARKS="rewardbench ppe rmb healthbench_rubric"
EVAL_BATCH_SIZE=24
EVAL_WORKERS=6

RUN_SFT=1
REBUILD_SPLIT=1

SFT_EPOCHS=1
SFT_TRAIN_BATCH=32
SFT_MICRO_BATCH=2
SFT_NPROC=1
SFT_OUTPUT_DIR=/path/to/GRM/checkpoints/sft_hb_synth_limit100
SFT_EXPERIMENT_NAME=hb_synth_limit100

SFT_JSONL=/path/to/GRM/data/sft_weighted_mix_limit100x2.jsonl
PRE_DIR=/path/to/GRM/results/sft_eval/pre
POST_DIR=/path/to/GRM/results/sft_eval/post
COMPARISON_MD=/path/to/GRM/results/sft_eval/rubric_comparison.md
COMPARISON_JSONL=/path/to/GRM/results/sft_eval/rubric_comparison.jsonl
WRITEUP_OUT=/path/to/GRM/sft_writeup.md
